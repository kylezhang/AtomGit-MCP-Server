# Optional: MCP transport. Default is stdio. Set to "http" to serve the
# Streamable HTTP endpoint (compatible with SSE streaming responses) for
# remote clients, listening on http://${ATOMGIT_HOST}:${ATOMGIT_PORT}/mcp.
# The server binds to 127.0.0.1 by default; there is no built-in auth, so only
# expose it publicly behind an authenticated proxy/TLS. ATOMGIT_TRANSPORT=sse
# is not supported - the "sse" value has been removed, use "http" instead.
# ATOMGIT_TRANSPORT=stdio
# ATOMGIT_HOST=127.0.0.1
# ATOMGIT_PORT=3000

# AtomGit MCP Server Configuration
# Default API base URL: https://api.atomgit.com
# Override it (e.g. for a custom gateway/proxy or local mock) by setting ATOMGIT_API_BASE_URL.
# Get your personal access token from: https://atomgit.com/setting/token-classic
ATOMGIT_TOKEN=your_personal_access_token_here

# Optional: override the AtomGit API base URL. Defaults to https://api.atomgit.com when unset.
# ATOMGIT_API_BASE_URL=https://api.atomgit.com

# Optional: enable dangerous tools such as delete/remove/archive/transfer actions.
# Default is false. Set to true and restart the server only when you explicitly need them.
ATOMGIT_ENABLE_DANGEROUS_TOOLS=false

# Optional: HTTP request timeout in milliseconds. Defaults to no timeout when unset.
# ATOMGIT_TIMEOUT_MS=30000
